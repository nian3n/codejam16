{
  "id": "body",
  "title": "Body scanner",
  "widget": "icons",
  "topic": "body parts",
  "hard": false,
  "looks_like": "A scanner with four buttons, each showing a part of the body.",
  "pool": [
    "ear",
    "eye",
    "nose",
    "mouth",
    "tooth",
    "tongue",
    "hair",
    "arm",
    "finger",
    "feet"
  ],
  "target_words": "name",
  "setup": {
    "shown": 4
  },
  "rules": [
    {
      "if": [
        [
          "has:nose",
          "==",
          true
        ],
        [
          "has:mouth",
          "==",
          true
        ]
      ],
      "then": {
        "verb": "press",
        "target": {
          "icon": "mouth"
        }
      }
    },
    {
      "if": [
        [
          "has:ear",
          "==",
          true
        ],
        [
          "has:eye",
          "==",
          true
        ]
      ],
      "then": {
        "verb": "press",
        "target": {
          "icons": [
            "ear",
            "eye"
          ]
        }
      }
    },
    {
      "if": [
        [
          "last",
          "==",
          "eye"
        ]
      ],
      "then": {
        "verb": "press",
        "target": {
          "icon": "first"
        }
      }
    },
    {
      "if": [
        [
          "has:hair",
          "==",
          true
        ]
      ],
      "then": {
        "verb": "press",
        "target": {
          "icon": "hair"
        }
      }
    },
    {
      "else": {
        "verb": "press",
        "target": {
          "icon": "last"
        }
      }
    }
  ]
}
