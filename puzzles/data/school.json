        "target": {
          "icon": "scissors"
        }
      }
    },
    {
      "if": [
        [
          "first",
          "==",
          "flag"
        ]
      ],
      "then": {
        "verb": "press",
        "target": {
          "icon": "last"
        }
      }
    },
    {
      "else": {
        "verb": "press",
        "target": {
          "icon": "pencil"
        }
      }
    }
  ]
}
