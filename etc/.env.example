# Copy this file to etc/.env and fill in your own values.
# etc/.env is git-ignored. Never commit real keys.
# src/config.py loads etc/.env at startup. A real environment variable wins.

# LLM provider key. The alien comes later, and the provider is not chosen yet.
LLM_API_KEY=

# TURN relay for the video (Metered, free tier). Without it, the video uses STUN
# only and can fail on phone data or strict Wi-Fi. Fill in ONE of the two options.
#
# Option A (simplest): a TURN credential from the Metered dashboard.
# The browser gets this login, so do not reuse it for anything else.
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional, comma-separated. The default is Metered's global.relay.metered.ca URLs.
TURN_URLS=
#
# Option B: the Metered app name (the part before .metered.live) and its API key.
# The server then hands out short-lived logins, and the key stays secret.
METERED_APP=
METERED_API_KEY=
